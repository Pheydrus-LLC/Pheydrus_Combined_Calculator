# Reel pipeline env template
# Copy this file to .env.local and fill values.
# Do not commit .env.local.

# Required: transcript API
GETTRANSCRIBE_KEY=

# Required: Google OAuth user credentials
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=

# Required: captions step
OPENAI_API_KEY=

# Optional: where new Google Docs are moved
GOOGLE_DRIVE_FOLDER_ID=

# Optional: Slack posting (incoming webhook, not OAuth bot scopes)
SLACK_TRANSCRIPT_WEBHOOK_URL=
SLACK_WEBHOOK_URL=
SLACK_TRANSCRIPT_CHANNEL=#video-transcripts

# Optional: caption settings
CAPTION_LANGUAGE=en
CAPTION_MAX_CHARS=24
CAPTION_MAX_LINES=3
